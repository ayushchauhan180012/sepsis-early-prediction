# Environment-specific configuration. Copy this file to `.env` and fill in
# real values. `.env` is git-ignored and must NEVER be committed.
#
# Frozen model/training constants (vital medians, feature names, alert params)
# are NOT in this file — they are tracked and reproducible in
# Backend/config.py, sourced from docs/TRAINING_CONTRACT.md.

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sepsis_db
# MODEL_PATH=Backend/Model/hgb_sepsis_model.joblib
# NOTIFICATION_CHANNEL=noop       # noop (default) | console
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
